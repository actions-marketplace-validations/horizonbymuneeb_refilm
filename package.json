{
  "name": "refilm",
  "version": "0.1.0",
  "description": "Record a reference animation, rebuild it in your code, re-film the copy and compare frame by frame until it matches.",
  "type": "module",
  "bin": { "refilm": "./dist/cli.js" },
  "main": "./dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "skill", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["animation", "reverse-engineering", "playwright", "motion", "verification", "agent-skill", "cli"],
  "license": "MIT",
  "dependencies": {
    "playwright": "1.64.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5"
  }
}
