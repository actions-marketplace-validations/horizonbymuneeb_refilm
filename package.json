{
  "name": "refilm",
  "version": "0.1.2",
  "description": "Record a reference animation, rebuild it in your code, re-film the copy and compare frame by frame until it matches.",
  "keywords": [
    "animation",
    "reverse-engineering",
    "playwright",
    "motion",
    "verification",
    "agent-skill",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizonbymuneeb/refilm.git"
  },
  "homepage": "https://github.com/horizonbymuneeb/refilm#readme",
  "bugs": {
    "url": "https://github.com/horizonbymuneeb/refilm/issues"
  },
  "author": "Muneeb Anjum",
  "type": "module",
  "bin": {
    "refilm": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "demo",
    "docs/media",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
